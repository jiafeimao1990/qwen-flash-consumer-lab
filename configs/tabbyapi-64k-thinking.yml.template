network:
  host: 127.0.0.1
  port: __PORT__
  disable_auth: true
  allowed_origins: []
  disable_fetch_requests: true
  api_servers: ["OAI"]
  sse_ping_interval: 15
  access_log: false

logging:
  log_prompt: false
  log_generation_params: false
  log_requests: false
  log_live_status: false
  log_timestamps: true

model:
  model_dir: __MODEL_ROOT__
  model_name: __MODEL_NAME__
  backend: exllamav3
  max_seq_len: __CONTEXT_TOKENS__
  cache_size: __CONTEXT_TOKENS__
  cache_mode: Q4
  tensor_parallel: false
  gpu_split_auto: false
  autosplit_reserve: [512, 512]
  gpu_split: [__GPU_SPLIT__]
  cpu_moe_split_experts: __CPU_EXPERTS__
  cpu_moe_threads: __CPU_THREADS__
  ngram_ram: false
  chunk_size: 4096
  output_chunking: true
  max_batch_size: 1
  vision: false
  template_vars_default:
    enable_thinking: true
  reasoning: true
  reasoning_budget_tokens: __REASONING_BUDGET__
  tool_format: qwen3_coder

draft_model:
  draft_mode: mtp
  draft_cache_mode: Q4
  draft_num_tokens: 3
  dynamic_draft: true

sampling:
  override_preset: safe_defaults

memory:
  sysmem_recurrent_cache: 1024
  sysmem_kv_cache: 0
  sysmem_multimodal_cache: 0
  cuda_malloc_async: false

developer:
  unsafe_launch: false
  disable_request_streaming: false
  realtime_process_priority: false
