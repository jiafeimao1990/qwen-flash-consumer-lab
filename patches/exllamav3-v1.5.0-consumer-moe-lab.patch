--- /dev/null
+++ b/exllamav3/modules/moe_trace.py
@@ -0,0 +1,110 @@
+"""Low-overhead routing trace for split CPU/GPU MoE experiments.
+
+The hot path only copies the router selections into a preallocated CUDA tensor.  Host
+synchronization, JSON serialization and cache-policy analysis happen after the generator
+queue drains.  Nothing is enabled unless EXL3_MOE_TRACE_PATH is set.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import time
+from pathlib import Path
+
+import torch
+
+
+TRACE_PATH = os.environ.get("EXL3_MOE_TRACE_PATH")
+TRACE_ROWS = max(1, int(os.environ.get("EXL3_MOE_TRACE_ROWS", "8192")))
+TRACE_MAX_BSZ = max(1, int(os.environ.get("EXL3_MOE_TRACE_MAX_BSZ", "8")))
+
+
+def init_moe_trace(module) -> None:
+    if (
+        not TRACE_PATH
+        or module.cpu_split_first is None
+        or getattr(module, "_moe_trace_registered", False)
+    ):
+        return
+    top_k = int(module.num_experts_per_tok)
+    module._moe_trace_selected = torch.empty(
+        (TRACE_ROWS, top_k), dtype=torch.int16, device=module.device
+    )
+    module._moe_trace_rows = 0
+    module._moe_trace_dropped = 0
+    module._moe_trace_registered = True
+    ip = module.config.infer_params
+    registry = getattr(ip, "moe_trace_modules", None)
+    if registry is None:
+        registry = []
+        ip.moe_trace_modules = registry
+        ip.moe_trace_sequence = 0
+    registry.append(module)
+
+
+def record_moe_trace(module, selected_experts: torch.Tensor, bsz: int) -> None:
+    buf = getattr(module, "_moe_trace_selected", None)
+    selected = selected_experts.reshape(-1, selected_experts.shape[-1])
+    if buf is None or bsz > TRACE_MAX_BSZ or selected.shape[0] > TRACE_MAX_BSZ:
+        return
+    start = int(module._moe_trace_rows)
+    take = min(int(selected.shape[0]), int(buf.shape[0]) - start)
+    if take > 0:
+        # copy_ performs the int64 -> int16 conversion on the current CUDA stream and does
+        # not synchronize with the host. Qwen3.8 has 512 experts, well inside int16.
+        buf[start:start + take].copy_(selected[:take], non_blocking=True)
+        module._moe_trace_rows = start + take
+    module._moe_trace_dropped += int(selected.shape[0]) - take
+
+
+def flush_moe_trace(infer_params) -> None:
+    if not TRACE_PATH:
+        return
+    registry = getattr(infer_params, "moe_trace_modules", None)
+    if not registry:
+        return
+    seen = set()
+    active = []
+    for module in registry:
+        if id(module) in seen or not getattr(module, "_moe_trace_rows", 0):
+            continue
+        seen.add(id(module))
+        active.append(module)
+    if not active:
+        return
+
+    for device_idx in sorted({int(m.device.index) for m in active}):
+        torch.cuda.synchronize(device_idx)
+
+    path = Path(TRACE_PATH)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    seq = int(getattr(infer_params, "moe_trace_sequence", 0))
+    infer_params.moe_trace_sequence = seq + 1
+    stamp = time.time_ns()
+
+    with path.open("a", encoding="utf-8") as f:
+        for module in active:
+            rows = int(module._moe_trace_rows)
+            placement = getattr(module, "_split_map", None)
+            if placement is None:
+                placement_ids = list(range(int(module.num_experts)))
+            else:
+                placement_ids = placement.detach().cpu().tolist()
+            record = {
+                "schema": 1,
+                "sequence": seq,
+                "time_ns": stamp,
+                "module": module.key,
+                "device": int(module.device.index),
+                "num_experts": int(module.num_experts),
+                "top_k": int(module.num_experts_per_tok),
+                "gpu_slots": int(module.cpu_split_first),
+                "rows": rows,
+                "dropped": int(module._moe_trace_dropped),
+                "placement": placement_ids,
+                "selected": module._moe_trace_selected[:rows].cpu().tolist(),
+            }
+            f.write(json.dumps(record, separators=(",", ":")) + "\n")
+            module._moe_trace_rows = 0
+            module._moe_trace_dropped = 0
